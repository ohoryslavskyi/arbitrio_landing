# Внутрішній Caddy лендінгу: віддає зібраний `dist/` і більше нічого.
#
# ⚠️ Це НЕ той Caddy, що стоїть на 80/443. Публічний живе в монорепі ArbBot
# (`admin-saas/Caddyfile`), тримає сертифікати й розводить імена; сюди він заводить
# лише `/presentation/*`, знявши префікс. Тому тут — голий :8080 без TLS і без ACME.
#
# Файл їде на коробку разом зі збіркою (`/srv/arbitrio-landing/Caddyfile`) і
# монтується в контейнер як `/srv/Caddyfile`. Тобто цей репозиторій володіє не лише
# вмістом сторінки, а й тим, ЯК її віддають: CSP і кеш-заголовки прив'язані до того,
# що сторінка вантажить, і розводити їх по двох репозиторіях означало б міняти CSP
# у чужому місці щоразу, коли тут з'явиться новий зовнішній ресурс.
{
	# Адмін-API нікому не потрібен, а це ще один відкритий порт.
	#
	# ⚠️ Наслідок, про який треба пам'ятати при зміні ЦЬОГО файла: `caddy reload`
	# працює саме через адмін-API, тож тут він неможливий у принципі. Новий конфіг
	# підхоплюється лише рестартом контейнера — і пайплайн робить його сам, звіряючи
	# mtime файла зі StartedAt контейнера.
	admin off
	# Сертифікатів цей сервіс не бере: він стоїть за проксі у внутрішній мережі, і
	# спроба ACME на ім'я, якого в нього немає, лише сипала б помилками в лог.
	auto_https off
}

:8080 {
	# Окремий шлях для healthcheck образу: `/` теж працює, але тоді перевірка тягла б
	# індекс на кожні 30 секунд і засмічувала лог доступу.
	#
	# 🔴 Він свідомо НЕ залежить від `current`: healthcheck має відповідати «процес
	# живий», а не «є контент». Інакше перший запуск на порожньому `/srv` заганяв би
	# контейнер у unhealthy, і деплой не мав би куди покласти файли.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		# `current` — СИМЛІНК на `releases/<sha>`, який перемикає пайплайн. Caddy
		# розв'язує його на кожен запит, тож перемик діє миттєво й без рестарту:
		# саме тому релізи лежать каталогами, а не перезаписуються на місці.
		#
		# 🔴 Симлінк мусить бути ВІДНОСНИЙ (`releases/<sha>`, а не `/srv/arbitrio-landing/…`):
		# всередині контейнера каталог змонтований як `/srv`, і абсолютний шлях із хоста
		# тут не існує — Caddy віддавав би 404 на все.
		root * /srv/current
		encode gzip zstd

		header {
			# Сторінка статична й не тягне нічого, крім шрифтів Google: вони приходять
			# `@import`ом із `src/styles/base.css` — стилі з fonts.googleapis.com,
			# самі файли шрифтів із fonts.gstatic.com.
			#
			# ⛔ `'unsafe-inline'` у style-src свідомо НЕМАЄ: Vite виносить увесь CSS
			# у файл, а `:style` у Vue пише через CSSOM (`el.style`), якого CSP не
			# стосується. Те саме з сіткою квадратів — `usePointerGrid` теж пише
			# в `element.style`.
			#
			# Послаблювати політику «про всяк випадок» не треба: якщо сторінка почне
			# вантажити щось нове, це видно одразу як `Refused to…` у консолі.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			-Server
		}

		# Імена файлів у `assets/` містять хеш вмісту: нова збірка = нове ім'я, тож
		# кешувати їх можна назавжди.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# А от індекс — ніколи: саме він називає імена нових бандлів. Закешований
		# індекс після деплою просив би файли, яких уже немає.
		@index path / /index.html
		header @index Cache-Control "no-cache"

		file_server
	}
}
